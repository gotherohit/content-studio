{
  "name": "content-studio",
  "version": "0.20.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/beats.test.ts test/reading-position.test.js test/pages.test.js test/links.test.ts test/files.test.js test/code.test.ts test/pdf.test.ts test/shapes.test.ts test/shapes-dom.test.js test/handoff.test.js test/research-agent.test.js test/jupyter.test.js test/highlights.test.js",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "dev:desktop": "concurrently -n vite,electron -c green,magenta \"npm --prefix client run dev\" \"npm run electron:dev\"",
    "electron:dev": "cross-env CS_DEV=1 electron .",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@mozilla/readability": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "jsdom": "^25.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Content Studio",
  "description": "A single-screen studio for researching and presenting technical stories.",
  "author": {
    "name": "gotherohit",
    "email": "rohitkrsingh2000@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gotherohit/content-studio.git"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "build": {
    "appId": "com.gotherohit.contentstudio",
    "productName": "Content Studio",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/test/**",
      "!**/.bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ContentStudio-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Content Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gotherohit",
        "repo": "content-studio",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}
